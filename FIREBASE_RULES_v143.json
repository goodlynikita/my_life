{
  "rules": {
    "nik-data": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      ".write": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      "training": {
        ".read": "auth != null && root.child('clientTrainer').child('nik-data').child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true",
        "plans": {
          "$p": {
            ".write": "auth != null && root.child('clientTrainer').child('nik-data').child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true && newData.exists()"
          }
        },
        "measurements": {
          "$m": {
            ".write": "auth != null && root.child('clientTrainer').child('nik-data').child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true && newData.exists()"
          }
        },
        "catalog": {
          "$c": {
            ".write": "auth != null && root.child('clientTrainer').child('nik-data').child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true"
          }
        },
        "coachRev": {
          ".write": "auth != null && root.child('clientTrainer').child('nik-data').child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true"
        },
        "coachWeekly": {
          ".write": "auth != null && root.child('clientTrainer').child('nik-data').child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid && root.child('userIndex').child($uid).child('blocked').val() !== true",
        ".write": "auth != null && $uid === auth.uid && root.child('userIndex').child($uid).child('blocked').val() !== true",
        "training": {
          ".read": "auth != null && root.child('clientTrainer').child($uid).child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true",
          "plans": {
            "$p": {
              ".write": "auth != null && root.child('clientTrainer').child($uid).child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true && newData.exists()"
            }
          },
          "measurements": {
            "$m": {
              ".write": "auth != null && root.child('clientTrainer').child($uid).child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true && newData.exists()"
            }
          },
          "catalog": {
            "$c": {
              ".write": "auth != null && root.child('clientTrainer').child($uid).child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true"
            }
          },
          "coachRev": {
            ".write": "auth != null && root.child('clientTrainer').child($uid).child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true"
          },
          "coachWeekly": {
            ".write": "auth != null && root.child('clientTrainer').child($uid).child('trainerUid').val() === auth.uid && root.child('trainers').child(auth.uid).child('blocked').val() !== true"
          }
        }
      }
    },
    "trainers": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'nedomolkin.1998@mail.ru' || ($uid === auth.uid && newData.exists() && newData.child('blocked').val() === data.child('blocked').val() && ((!data.exists() && newData.child('limit').val() === 50 && newData.child('tier').val() === 'free') || (data.exists() && newData.child('limit').val() === data.child('limit').val() && newData.child('tier').val() === data.child('tier').val()))))",
        ".validate": "!newData.hasChild('uid') || newData.child('uid').val() === $uid"
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'nedomolkin.1998@mail.ru' || ((!data.exists() || data.child('trainerUid').val() === auth.uid) && (!newData.exists() || newData.child('trainerUid').val() === auth.uid)))"
      }
    },
    "accessKeys": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && (newData.child('key').val() === auth.uid || (newData.child('key').val() === 'nik-data' && auth.token.email === 'nedomolkin.1998@mail.ru')) && (newData.child('root').val() === 'users/' + auth.uid || (newData.child('root').val() === 'nik-data' && auth.token.email === 'nedomolkin.1998@mail.ru')) && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 90000000) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && newData.parent().parent().child('clientTrainer').child(data.child('key').val()).child('trainerUid').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z0-9]{8}$/)",
        "key": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "root": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "prev": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "clientTrainer": {
      "$k": {
        ".read": "auth != null && ($k === auth.uid || ($k === 'nik-data' && auth.token.email === 'nedomolkin.1998@mail.ru') || data.child('trainerUid').val() === auth.uid)",
        ".write": "auth != null && ($k === auth.uid || ($k === 'nik-data' && auth.token.email === 'nedomolkin.1998@mail.ru') || (data.child('trainerUid').val() === auth.uid && !newData.exists()) || (newData.child('trainerUid').val() === auth.uid && newData.child('akey').isString() && newData.child('akey').val().matches(/^[A-Z0-9]{8}$/) && root.child('accessKeys').child(newData.child('akey').val()).child('key').val() === $k && ($k === 'nik-data' || root.child('accessKeys').child(newData.child('akey').val()).child('uid').val() === $k) && root.child('accessKeys').child(newData.child('akey').val()).child('expiresAt').val() > now && root.child('accessKeys').child(newData.child('akey').val()).child('expiresAt').val() <= now + 90000000 && !newData.parent().parent().child('accessKeys').child(newData.child('akey').val()).exists()))"
      }
    },
    "clientSlots": {
      "$k": {
        ".read": "auth != null && ($k === auth.uid || ($k === 'nik-data' && auth.token.email === 'nedomolkin.1998@mail.ru') || root.child('clientTrainer').child($k).child('trainerUid').val() === auth.uid)",
        "$id": {
          ".write": "auth != null && root.child('clientTrainer').child($k).child('trainerUid').val() === auth.uid && $id.beginsWith(auth.uid + '_')"
        }
      }
    },
    "trainerClients": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      "$t": {
        ".read": "auth != null && $t === auth.uid",
        "$c": {
          ".write": "auth != null && ($t === auth.uid || (($c === auth.uid || ($c === 'nik-data' && auth.token.email === 'nedomolkin.1998@mail.ru')) && (!newData.exists() || root.child('clientTrainer').child($c).child('trainerUid').val() === $t || newData.parent().parent().parent().child('clientTrainer').child($c).child('trainerUid').val() === $t)))",
          ".validate": "!newData.hasChild('root') || ($c === 'nik-data' && newData.child('root').val() === 'nik-data') || ($c !== 'nik-data' && newData.child('root').val() === 'users/' + $c)"
        }
      }
    },
    "trainerAI": {
      "$t": {
        ".read": "auth != null && $t === auth.uid",
        ".write": "auth != null && $t === auth.uid"
      }
    },
    "trainerTemplates": {
      "$t": {
        ".read": "auth != null && $t === auth.uid",
        ".write": "auth != null && $t === auth.uid"
      }
    },
    "trainerSchedule": {
      "$t": {
        ".read": "auth != null && $t === auth.uid",
        ".write": "auth != null && $t === auth.uid"
      }
    },
    "aiUsage": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },
    "aiStats": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'"
    },
    "stats": {
      ".read": true,
      "usersCount": {
        ".write": "auth != null && (auth.token.email === 'nedomolkin.1998@mail.ru' || (newData.isNumber() && ((data.isNumber() && newData.val() === data.val() + 1) || (!data.isNumber() && newData.val() === 1))))"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'"
    },
    "feedback": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      "$id": {
        ".write": "!data.exists() || (auth != null && auth.token.email === 'nedomolkin.1998@mail.ru')",
        ".validate": "(auth != null && auth.token.email === 'nedomolkin.1998@mail.ru') || (newData.child('text').isString() && newData.child('text').val().length <= 4000 && !newData.hasChild('id') && (!newData.hasChild('uid') || (auth != null && newData.child('uid').val() === auth.uid)))"
      }
    },
    "refs": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      "$by": {
        ".read": "auth != null && $by === auth.uid",
        "$u": {
          ".write": "auth != null && $u === auth.uid && !data.exists()"
        }
      }
    },
    "userIndex": {
      ".read": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && auth.token.email === 'nedomolkin.1998@mail.ru'",
        "email": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "name": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "createdAt": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "lastSeen": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "ua": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "noticeSeen": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "m": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "errs": {
          ".write": "auth != null && $uid === auth.uid"
        },
        "ref": {
          ".write": "auth != null && $uid === auth.uid && !data.exists()"
        }
      }
    },
    "sharedTemplates": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid && (!newData.exists() || newData.child('authorUid').val() === auth.uid)) || auth.token.email === 'nedomolkin.1998@mail.ru')",
        ".validate": "$code.matches(/^[A-Z0-9]{6,10}$/) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('authorName').isString() && newData.child('authorName').val().length <= 60"
      }
    },
    "sharedTemplateUses": {
      "$code": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && root.child('sharedTemplates').child($code).exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "userShared": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "inboxOwner": {
      "$key": {
        ".read": "auth != null && data.val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$key.matches(/^[A-Za-z0-9]{24}$/) && newData.isString()"
      }
    },
    "inbox": {
      "$key": {
        ".read": "auth != null && root.child('inboxOwner').child($key).val() === auth.uid",
        ".write": "auth != null && root.child('inboxOwner').child($key).val() === auth.uid && !newData.exists()",
        "$id": {
          ".write": "(!data.exists() && newData.exists() && root.child('inboxOwner').child($key).exists()) || (auth != null && root.child('inboxOwner').child($key).val() === auth.uid && !newData.exists())",
          ".validate": "newData.hasChild('k')",
          "k": {
            ".validate": "newData.isString() && newData.val().matches(/^(sms|day|workout)$/)"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "from": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "start": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "n": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 30)"
          },
          "kcal": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 30)"
          },
          "min": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 30)"
          },
          "km": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 30)"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    }
